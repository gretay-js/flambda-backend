(executable
 (name simdgen)
 (modes native)
 (modules simdgen arm64_simd_defs))

(rule
 (target arm64_simd_instrs.ml)
 (deps simdgen.exe arm64/advsimd.csv)
 (mode promote)
 (action
  (with-stdout-to
   arm64_simd_instrs.ml
   (run ./simdgen.exe arm64/advsimd.csv))))
